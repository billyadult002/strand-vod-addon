{
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "/api/manifest.js"
    },
    {
      "src": "/billy-manifest.json",
      "dest": "/api/billy-manifest.js"
    },
    {
      "src": "/top50.json",
      "dest": "/api/top50.js"
    },
    {
      "src": "/playlist.m3u8",
      "dest": "/api/playlist.m3u8.js"
    },
    {
      "src": "/live.m3u8",
      "dest": "/api/playlist.m3u8.js"
    },
    {
      "src": "/tv.m3u8",
      "dest": "/api/playlist.m3u8.js"
    },
    {
      "src": "/channels.m3u8",
      "dest": "/api/playlist.m3u8.js"
    },
    {
      "src": "/playlist.m3u",
      "dest": "/api/playlist.js"
    },
    {
      "src": "/sources.json",
      "dest": "/api/sources.js"
    },
    {
      "src": "/tvbox.json",
      "dest": "/api/tvbox.js"
    },
    {
      "src": "/catalog/(.*)",
      "dest": "/api/catalog.js"
    },
    {
      "src": "/meta/(.*)",
      "dest": "/api/meta.js"
    },
